{
  "manifest_version": 3,
  "name": "OPTCG Companion",
  "version": "0.2.0",
  "description": "Sends your OneSimulator match to the local companion HUD",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:9003/*",
    "https://onesimulator.slidingcodes.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onesimulator.slidingcodes.com/*",
        "http://onesimulator.slidingcodes.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OPTCG Companion"
  }
}
