# Copy to .env or .env.local (those files are gitignored), then ./start
# Or paste the key on the Setup tab — that stays on this machine.

# Required for conversational Ask answers (OpenAI or any compatible API)
OPTCG_LLM_API_KEY=sk-...

# Optional — these are the defaults
# OPTCG_LLM_MODEL=gpt-4o-mini
# OPTCG_LLM_BASE_URL=https://api.openai.com/v1

# Local runner example (Ollama)
# OPTCG_LLM_BASE_URL=http://localhost:11434/v1
# OPTCG_LLM_MODEL=llama3.1
# OPTCG_LLM_API_KEY=ollama
