#!/usr/bin/env bash
# Open the OPTCG Companion.
#   ./start                 demo cards (no real game)
#   ./start onesimulator    live OneSimulator match
#   ./start --terminal      print the HUD in this shell
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

MODE=mock
TERMINAL=0
case "${1:-}" in
  --terminal | hud) TERMINAL=1 ;;
  onesimulator | one | --onesimulator | --live | live) MODE=onesimulator ;;
  mock | --mock | "") MODE=mock ;;
  *)
    printf 'Unknown option: %s\nUse: ./start   or   ./start onesimulator\n' "$1" >&2
    exit 1
    ;;
esac

say() { printf '%s\n' "$*"; }
die() { printf 'Could not start: %s\n' "$*" >&2; exit 1; }

need_cmd() {
  local name="$1" hint="$2"
  command -v "$name" >/dev/null 2>&1 || die "$hint"
}

say "OPTCG Companion"
say ""

need_cmd node "Node.js is missing. On a Mac: brew install node"
need_cmd npm  "npm is missing. Reinstall Node.js, then run ./start again."
need_cmd cargo "Rust is missing. Paste this, close Terminal, reopen it, then run ./start again:
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"

if [[ ! -d node_modules || ! -d src-ui/node_modules ]]; then
  say "Installing dependencies (once)…"
  npm install
  (cd src-ui && npm install)
fi

if [[ "$MODE" == "mock" || "$TERMINAL" -eq 1 ]]; then
  need_cmd python3 "Python 3 is missing. On a Mac: brew install python"
  if ! python3 -c "import websockets" >/dev/null 2>&1; then
    say "Installing the Python package the demo stream needs…"
    python3 -m pip install --user websockets >/dev/null
  fi
fi

# The OneSimulator extension is two plain JS files. No build step.
# A leftover dist/ is the old WebSocket worker — wipe it so it cannot be loaded.
rm -rf "$ROOT/browser-companion/dist"

export OPTCG_SOURCE="$MODE"

say ""
if [[ "$TERMINAL" -eq 1 ]]; then
  say "Printing the HUD in this terminal. Ctrl-C stops it."
  say "In another terminal, from this same folder:  python3 scripts/mock_stream.py"
  say ""
  exec cargo run -p optcg-companion -- --terminal
fi

say "A window named OPTCG Companion is about to open."
say "The first launch compiles Rust and can take several minutes — leave this running."
say "Ctrl-C stops everything."
say ""

if [[ "$MODE" == "onesimulator" ]]; then
  say "OneSimulator — do these three things while the window compiles:"
  say ""
  say "  1. Chrome → chrome://extensions"
  say "  2. Developer mode ON → remove every old Companion / Bridge card"
  say "  3. Load unpacked → pick this folder (not dist):"
  say "       $ROOT/browser-companion"
  say "  4. The card should say OPTCG Companion  0.2.3"
  say "  5. Open a match:  https://onesimulator.slidingcodes.com"
  say ""
  say "A label in the bottom-right of the game says if it is working."
  say "If Chrome shows dist/bridge.js or ws://127.0.0.1:9003, that is the old extension."
  say ""
  if command -v open >/dev/null 2>&1; then
    open "https://onesimulator.slidingcodes.com" 2>/dev/null || true
    open "chrome://extensions" 2>/dev/null || true
  fi
  exec npm run dev:tauri
fi

say "Demo cards will start moving once the window is up."
say "For a real match instead:  ./start onesimulator"
say ""

exec npx --yes concurrently -k -n hud,demo -c blue,green \
  "npm run dev:tauri" \
  "python3 scripts/mock_stream.py --interval 2"
